    "permission_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EisuKana Switch needs Input Monitoring access to notice the left and right ⌘ keys. Allow it in System Settings > Privacy & Security > Input Monitoring."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右の ⌘ キーが押されたことを知るために、「入力監視」の許可が必要です。システム設定 > プライバシーとセキュリティ > 入力監視 で EisuKana Switch をオンにしてください。"
          }
        }
      }
    },
